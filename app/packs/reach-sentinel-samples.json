{
  "format": "reach-pack",
  "version": 2,
  "id": "reach-sentinel-samples",
  "name": "Reach sample tables (Sentinel)",
  "pack_version": "0.3.0",
  "description": "The three custom tables the development workspace seeds, bound to the CloudTrail, Entra sign-in and Falcon feeds. Bindings and KQL templates only; the meanings live with the feeds.",
  "source": "splunk/attack_data captures (T1110.003 password_spraying_azuread, T1003.001 atomic_red_team crowdstrike_falcon, T1078 aws_createaccesskey); Microsoft Entra sign-in log reference; CrowdStrike event data dictionary; AWS CloudTrail record contents reference; the Splunk-side aws-cloudtrail pack",
  "params": {
    "earliest": {
      "label": "since",
      "placeholder": "-24h",
      "hint": "On TimeGenerated (replay time for these samples, the connector's event time in production). SourceEventTime keeps the capture's own timestamp."
    },
    "latest": {
      "label": "until",
      "placeholder": "now",
      "hint": "Optional. Ingestion lags event time by minutes; a tight bound can miss the newest rows."
    },
    "value": {
      "label": "value",
      "placeholder": "the value you are holding"
    }
  },
  "feed": {
    "id": "reach_samples",
    "label": "Reach sample loader",
    "description": "Provenance columns the loader adds to every sample row.",
    "tags": [
      "sample"
    ]
  },
  "concepts": {
    "dataset_id": {
      "label": "Dataset id",
      "type": "identifier",
      "description": "Which public sample dataset the row came from. Loader provenance, not a fact about the source system.",
      "role": "other"
    },
    "load_id": {
      "label": "Load id",
      "type": "identifier",
      "description": "Deterministic id of the load that wrote this row (hash of loader version, dataset and source content). Same id → same content; two copies of it → the dataset was replayed.",
      "role": "identifier"
    },
    "raw_event": {
      "label": "Raw event",
      "type": "raw_object",
      "description": "The complete source record as ingested, as a dynamic object. Anything not projected into a column is reachable here by path.",
      "role": "other"
    }
  },
  "containers": {
    "ReachAzureAD_CL": {
      "platform": "sentinel",
      "kind": "sample",
      "description": "Microsoft Entra ID (Azure AD) sign-in log records, one per authentication attempt: who signed in, from where, with which client and app, and how it ended (ResultType). The capture is a password spray: many users, one caller address, one failure code. In production the same shape is the SigninLogs table.",
      "tags": [
        "sample"
      ],
      "hazards": [
        "replay_time"
      ]
    },
    "ReachCrowdStrike_CL": {
      "platform": "sentinel",
      "kind": "sample",
      "description": "CrowdStrike Falcon sensor telemetry, one row per sensor event; EventSimpleName says which kind (ProcessRollup2 for a process start, DmpFileWritten for a memory dump landing on disk…). The capture is an LSASS credential-dump attempt. In production the same telemetry lands via the Falcon Data Replicator connector.",
      "tags": [
        "sample"
      ],
      "hazards": [
        "replay_time"
      ],
      "note": "SHA256HashData and ImageFileName carry the Falcon feed's names, so the known-good hash and path checks work here. The seeded capture has no SigningId, TeamId, CodeSigningFlags or CsValidationCategory column; those bind on Splunk's crowdstrike:events:sensor only until a real Falcon-for-Sentinel ingest is checked for them."
    },
    "ReachCloudTrail_CL": {
      "platform": "sentinel",
      "kind": "sample",
      "description": "AWS CloudTrail records, one per API call: the caller (PrincipalArn, UserIdentity), the operation (EventSource + EventName), where it came from (SourceIpAddress, UserAgent), the request and response objects, and the outcome (ErrorCode). The capture is access-key creation for an IAM user. In production the AWS S3 connector lands this as AWSCloudTrail with the same columns flattened.",
      "tags": [
        "sample"
      ],
      "hazards": [
        "replay_time"
      ]
    }
  },
