{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "Reach",
  "version": "1.0.0",
  "description": "A data catalogue for your SIEM, in place: what a Splunk or Sentinel field means, how to decode it, and what it can reach.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "storage",
    "activeTab",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "optional_host_permissions": [
    "*://*/*",
    "https://www.virustotal.com/*",
    "https://hashlookup.circl.lu/*",
    "https://api.first.org/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "app/lib/*",
        "app/components/*",
        "app/data/*",
        "app/packs/*",
        "live-lookup.js",
        "search-history-inject.js",
        "sentinel-editor-inject.js"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
